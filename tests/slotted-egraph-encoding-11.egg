;; Hand-encoded slotted egraph using the identity-at-literal convention
;; (each edge rename has keys = values = the child's own slot ids). Mirrors
;; what the --slotted auto-encoder emits, but written out by hand so this
;; file runs without the --slotted flag. Covers four α-equivalence cases:
;;
;;   1. Swap of two free variables:
;;        (App "f" v1 v2)  ≡  (App "f" v2 v1)
;;   2. Cyclic permutation of three variables, nested:
;;        (App "f" (App "g" v1 v2) v3)  ≡  (App "f" (App "g" v3 v1) v2)
;;   3. Same shape, different slot ids:
;;        (App "f" v1 v1)  ≡  (App "f" v2 v2)
;;   4. Negative — different free-slot counts should not unify:
;;        (App "f" v1 v1)  ≢  (App "f" v1 v2)
;;
;; The machinery (Renaming, RenamesToLeader, transitivity, leaf pair,
;; α-finder, migration, child-rewrites) is the same shape as the docs in
;; src/slotted_encoding.md.


;;; Machinery ;;;

(sort Renaming (Map i64 i64))

(sort U)

(constructor Var (i64) U)

;; `(App f m1 c1 m2 c2)` corresponds to the term `f(m1*c1, m2*c2)`
(constructor App (String Renaming U Renaming U) U)

;; `(RenamesToLeader follower m leader)` corresponds to `follower = m*leader`.
;; We require `leader <= follower` in terms of ordering-max.
(relation RenamesToLeader (U Renaming U))

;; transitivity
;; e1 = m12*e2 /\ e2 = m23*e2 --> e1 = m12*m23*e3
(rule ((RenamesToLeader e1 m12 e2)
       (RenamesToLeader e2 m23 e3))
      ((RenamesToLeader e1 (compose m12 m23) e3)))

;; replace (Var v) by [0 -> v] * (Var 0)
(rule ((= e (Var v))
       (!= v 0))
      ((RenamesToLeader e (map-insert (map-empty) 0 v) (Var 0))
      ; (delete (Var v)) ;; Deleting this causes unextractable value.
      )
)

;; α-finder: two App nodes with the same head and same children, related
;; by a single bijection on their edge renames.

;; Input: e1 = f(m1*c1, m1'*c2) /\ e2 = f(m2*c1, m2'*c2),
;; then m = (find-mapping m1 m1' m2 m2') is the smallest renaming, s.t. m*m2 = m1 /\ m*m2' = m1'
;; so that m*e2 = m*f(m2*c1, m2'*c2) = f(m*m2*c1, m*m2'*c2) = f(m1*c1, m1'*c2) = e1
;; so in short m*e2 = e1.
(rule ((= e1 (App f m1 c1 m1' c2))
       (= e2 (App f m2 c1 m2' c2))
       (= m (find-mapping m1 m1' m2 m2'))
       (= e1 (ordering-max e1 e2)))
      ((RenamesToLeader e1 m e2)))

;; migration:
;; if `e2 = f(m1*c1, m2*c2)` /\ `e2 = m*e1`, then `e1 = m⁻¹*e2 = m⁻¹*f(m1*c1, m2*c2) = f(m⁻¹*m1*c1, m⁻¹*m2*c2)`
(rule ((RenamesToLeader e2 m e1)
       (= e2 (App f m1 c1 m2 c2))
       (!= e1 e2))
      ((union e1 (App f (compose (inverse m) m1) c1 (compose (inverse m) m2) c2))))

;; per-position child rewrites- canonicalize children to use representatives
;; These replace `c` with the more canonical `m*c'`.
(rule ((RenamesToLeader c m c')
       (= node (App f m1 c m2 c2))
       (!= c c'))
      ((union node (App f (compose m1 m) c' m2 c2))))

(rule ((RenamesToLeader c m c')
       (= node (App f m1 c1 m2 c))
       (!= c c'))
      ((union node (App f m1 c1 (compose m2 m) c'))))



;;; Init setup:

; This guarantees that (Var 0) is the lowest ordering-max variable, and it has a reflexive RenamesToLeader entry.
(RenamesToLeader (Var 0) (map-insert (map-empty) 0 0) (Var 0))

;;; Tests ;;;


;;; Case 1: swap of two free variables ;;;
(push)

(let $a1 (App "f" (map-insert (map-empty) 20 20) (Var 20)
                  (map-insert (map-empty)  1  1) (Var 1)))

(let $a2 (App "f" (map-insert (map-empty)  1  1) (Var 1)
                  (map-insert (map-empty) 20 20) (Var 20)))

(run 10)

(fail (check (= $a1 $a2)))
(check (RenamesToLeader $a2 m1 leader)
       (RenamesToLeader $a1 m2 leader))

(pop)


;;; Case 2: three-variable cyclic permutation, nested ;;;
(push)

(let $b1 (App "f"
              (map-insert (map-insert (map-empty) 100 100) 200 200)
              (App "g" (map-insert (map-empty) 100 100) (Var 100)
                       (map-insert (map-empty) 200 200) (Var 200))
              (map-insert (map-empty) 300 300) (Var 300)))

(let $b2 (App "f"
              (map-insert (map-insert (map-empty) 100 100) 300 300)
              (App "g" (map-insert (map-empty) 300 300) (Var 300)
                       (map-insert (map-empty) 100 100) (Var 100))
              (map-insert (map-empty) 200 200) (Var 200)))

(run 10)

(check (RenamesToLeader $b1 m1 leader)
       (RenamesToLeader $b2 m2 leader))

(pop)


;;; Case 3: same shape, different slot ids ;;;
(push)

(let $c1 (App "h" (map-insert (map-empty) 50 50) (Var 50)
                  (map-insert (map-empty) 50 50) (Var 50)))

(let $c2 (App "h" (map-insert (map-empty) 60 60) (Var 60)
                  (map-insert (map-empty) 60 60) (Var 60)))

(run 10)

(check (RenamesToLeader $c1 m1 leader)
       (RenamesToLeader $c2 m2 leader))

(pop)


;;; Case 4 (negative): different free-slot counts ;;;
(push)

(let $d1 (App "k" (map-insert (map-empty) 50 50) (Var 50)
                  (map-insert (map-empty) 50 50) (Var 50)))

(let $d2 (App "k" (map-insert (map-empty) 50 50) (Var 50)
                  (map-insert (map-empty) 60 60) (Var 60)))


(run 10)

;; negative — should remain in distinct e-classes.
(fail (check (= $d1 $d2)))
(fail (check (RenamesToLeader $d1 m1 leader)
             (RenamesToLeader $d2 m2 leader)))

(pop)


;;; Case 5- redundancies
(push)

(let $c1 (App "f" (map-insert (map-empty) 20 20) (Var 20)
                  (map-insert (map-empty) 1 1) (Var 1)))
(let $c2 (App "g" (map-insert (map-empty) 20 20) (Var 20)
                  (map-insert (map-empty) 20 20) (Var 20)))

(union $c1 $c2)

(let $c3 (App "f" (map-insert (map-empty) 23 23) (Var 23)
                  (map-insert (map-empty) 24 24) (Var 24) ))
(let $c4 (App "f" (map-insert (map-empty) 23 23) (Var 23)
                  (map-insert (map-empty) 25 25) (Var 25) ))

(run 10)

(check (RenamesToLeader $c3 m1 leader)
       (RenamesToLeader $c1 m2 leader))

(check (RenamesToLeader $c3 m1 leader)
       (RenamesToLeader $c4 m2 leader))

(pop)


;;; Case 6- RenamesToLeader Var reflexivity test
(push)

(let $v1 (Var 1))
(let $v2 (Var 2))

(run 10)
(check (RenamesToLeader $v1 m1 leader)
       (RenamesToLeader $v2 m2 leader))

(extract $v2) ; This extraction should optimally return a renamed version of (Var 0)

(pop)
