; Tests rule rewriting where a user variable is matched as a constructor
; head in the body and used as a U-child in the action. The body atom
; `(= e (App "f" a b))` exposes `e`'s slot space through the body-bound
; edge renames `r_a` and `r_b`. The encoder synthesizes the identity
; rename over `values(r_a) ∪ values(r_b)` from those, and uses it as the
; edge rename for `e` in the action's `(App "wrap" e e)`.

(sort U)
(constructor Var (i64) U)
(constructor App (String U U) U)

(rule ((= e (App "f" a b)))
      ((union e (App "wrap" e e))))

(let $v1 (Var 5))
(let $v2 (Var 7))
(let $f (App "f" $v1 $v2))

;; explicit (run): the user-written rule lives in the default ruleset and
;; isn't fired by slotted maintenance (yet — see task #17).
(run 10)

(check (= $f (App "wrap" $f $f)))
