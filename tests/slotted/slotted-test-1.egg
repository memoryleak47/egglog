
(sort U)

(constructor Var (i64) U) ; variable with a i64 name
(constructor App (String U U) U)


(let $v1 (Var 20))
(let $v2 (Var 1))

(let $a1 (App "f" $v1 $v2))

(let $a2 (App "f" $v2 $v1))

;; equal up to renaming -- no explicit (run) needed because the slotted
;; maintenance ruleset is saturated between top-level commands.
(check (= $a1 $a2))