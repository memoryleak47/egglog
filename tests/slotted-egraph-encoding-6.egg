; A brutally simple slotted implementation that is not super efficient.
; The inefficiency comes from the fact that every node has *multiple* shapes depending on what variant of the children was chosen.

(sort Renaming (Map i64 i64))
(sort VecOfRenaming (Vec Renaming))

(sort U) ; includes terms, ids, nodes.

(constructor Var (i64) U)
(constructor App (String U U) U)
(constructor Rename (Renaming U) U)

; Rename inverse
(rule
    ((= a (Rename m b)))
    ((union b (Rename (inverse m) a)))
)

; Rename compose
(rule
    ((= x (Rename m1 (Rename m2 y))))
    ((union x (Rename (compose m1 m2) y)))
)

; shape computation for Var
(rule
    ((Var n))
    ((union (Var n) (Rename (map-insert (map-empty) 0 n) (Var 0))))
)

; shape computation for App
(rule 
    (
        (= x (App f (Rename m1 a1) (Rename m2 a2)))
        (= m_sh (shape2 m1 m2))
        ; m_sh :: slots(x) -> shape-slots
    )
    (
        (union x (Rename (inverse m_sh) (App f (Rename (compose m_sh m1) a1) (Rename (compose m_sh m2) a2))))
    )
)

; Test 1
(push)
(let $v1 (Var 24))
(let $v2 (Var 12))
(let $v3 (Var 3))
(let $v4 (Var 4))

(let $x (App "f" $v1 $v2))
(let $y (App "f" $v3 $v4))

(let $x2 (App "g" $x $v2))
(let $y2 (App "g" $y $v4))

(run 100)

; Here we check equality up to renaming!
(check (= $v1 (Rename _ $v4)))
(check (= $x2 (Rename _ $y2)))

(pop)

; Test 2: symmetries
(push)

(union
    (App "f" (Var 1) (Var 2))
    (App "f" (Var 2) (Var 1))
)

(let $a (App "g" (Var 42) (App "f" (Var 6) (Var 8))))
(let $b (App "g" (Var 42) (App "f" (Var 8) (Var 6))))

(run 100)

; Here we check equality up to renaming!
(check (= $a (Rename _ $b)))

(pop)


; Test 3: redundancies
(push)

(union
    (App "f" (Var 1) (Var 2))
    (App "f" (Var 1) (Var 3))
)

(let $a (App "g" (Var 42) (App "f" (Var 33) (Var 17))))
(let $b (App "g" (Var 42) (App "f" (Var 33) (Var 18))))

(run 100)

; Here we check equality up to renaming!
(check (= $a (Rename _ $b)))

(pop)
