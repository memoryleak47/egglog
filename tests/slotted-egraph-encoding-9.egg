
(sort Renaming (Map i64 i64))
(sort VecOfRenaming (Vec Renaming))

(sort U) ; includes terms, ids, nodes.

(constructor Var (i64) U)
(constructor App (String U U) U)
(constructor Rename (Renaming U) U)

; shape computation for Var
(rule
    (
        (Var n)
    )
    
    (
        (union (Var n) (Rename (map-insert (map-empty) 0 n) (Var 0)))
    )
)

; delete redundant vars- choose the smaller id
(rule
    (
        (= a (Var v1))
        (= b (Var v2))
        (= (Rename m a) b) 
        (= b (ordering-max a b)) ; a < b
        (!= a b)
    )
    (
        (delete (Var v2))
    )
)


; collapse nested renames- do we need this?
(rule
    (
        (= c (Rename m1 (Rename m2 a)))
    )
    (
        (union c (Rename (compose m1 m2) a))
    )
)


;; (App f (Rename ... (Var 3)) (Rename ... (Var 0)))
; shape computation for App
(rule 
    (
        (= x (App f (Rename m1 a1) (Rename m2 a2)))
        (= m_sh (shape2 m1 m2))
        ; m_sh :: slots(x) -> shape-slots
    )
    (
        (union x
           (Rename (inverse m_sh)
              (App f
                (Rename (compose m_sh m1) a1) (Rename (compose m_sh m2) a2))))
    )
)

;; Delete reduandant apps modulo their shape
(rule 
    (
        (= a (App f (Rename m1 a1) (Rename m2 a2)))
        (= b (App f
                 (Rename (compose m_sh m1) a1)
                 (Rename (compose m_sh m2) a2)))
        ;; Another app with same shape
        (= a (Rename (inverse m_sh) b))
        (= m_sh (shape2 m1 m2))

        (!= a b)
        (= b (ordering-max a b)) ; a < b
    )
    (
        (delete (App f
                 (Rename (compose m_sh m1) a1)
                 (Rename (compose m_sh m2) a2)))
    )
)


;;; EXAMPLES ;;;

(let $v1 (Var 24))
(let $v2 (Var 12))

(let $f1 (App "f" $v1 $v2))
; (let $f2 (App "f" $v2 $v1))

(run 10)

(print-function Rename)
(print-function Var)
(print-function App)
